{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "account.calibrestudio.co"
        }
      ],
      "destination": "https://billing.stripe.com/p/login/6oU5kFasScHuceq7jE6c000",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "account.calibrestudio.co"
        }
      ],
      "destination": "https://billing.stripe.com/p/login/6oU5kFasScHuceq7jE6c000",
      "permanent": false
    },
    {
      "source": "/account",
      "destination": "https://billing.stripe.com/p/login/6oU5kFasScHuceq7jE6c000",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/llms-full.txt"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "md"
        }
      ],
      "destination": "/llms-full.txt"
    },
    {
      "source": "/index.md",
      "destination": "/llms-full.txt"
    }
  ],
  "headers": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "md"
        }
      ],
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</llms-full.txt>; rel=\"alternate\"; type=\"text/markdown\""
        }
      ]
    },
    {
      "source": "/index.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    }
  ]
}
